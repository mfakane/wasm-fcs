<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="FSharp.Compiler.Service" Condition="'$(WasmFcsPath)' != ''">
      <HintPath>$(WasmFcsPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.400" Condition="'$(WasmFcsPath)' == ''" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Engine.fs" />
  </ItemGroup>
</Project>

