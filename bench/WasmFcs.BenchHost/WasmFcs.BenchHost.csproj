<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/WasmFcs.Core/WasmFcs.Core.fsproj" />
    <Reference Include="FSharp.Compiler.Service" Condition="'$(WasmFcsPath)' != ''">
      <HintPath>$(WasmFcsPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Import Project="../../src/WasmFcs.ReferencePack.props" />
</Project>
